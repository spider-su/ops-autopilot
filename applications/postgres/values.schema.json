{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["image", "resources", "postgresConfig", "storage", "service", "credentials", "resourceQuota", "networkPolicy", "pdb", "nodeSelector"],
  "properties": {
    "image": {"$ref": "#/definitions/image"}, "resources": {"$ref": "#/definitions/resources"},
    "postgresConfig": {"type": "object", "additionalProperties": false, "required": ["sharedBuffers", "workMem", "maintenanceWorkMem", "maxConnections"], "properties": {"sharedBuffers": {"type": "string"}, "workMem": {"type": "string"}, "maintenanceWorkMem": {"type": "string"}, "maxConnections": {"type": "string"}, "synchronousCommit": {"type": "string"}}},
    "storage": {"type": "object", "additionalProperties": false, "required": ["size", "storageClassName", "mountPath"], "properties": {"size": {"type": "string", "minLength": 1}, "storageClassName": {"type": "string", "minLength": 1}, "mountPath": {"type": "string", "minLength": 1}}},
    "service": {"type": "object", "additionalProperties": false, "required": ["port"], "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
    "credentials": {"type": "object", "additionalProperties": false, "required": ["secretName"], "properties": {"secretName": {"type": "string", "minLength": 1}}},
    "resourceQuota": {"$ref": "#/definitions/quota"}, "networkPolicy": {"type": "object", "additionalProperties": false, "required": ["enabled", "allowedNamespaces"], "properties": {"enabled": {"type": "boolean"}, "allowedNamespaces": {"type": "array", "items": {"type": "string", "minLength": 1}}}}, "pdb": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}}, "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "definitions": {
    "image": {"type": "object", "additionalProperties": false, "required": ["repository", "tag", "pullPolicy"], "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string", "minLength": 1}, "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "quantity": {"type": ["string", "number"]}, "quantities": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory"], "properties": {"cpu": {"$ref": "#/definitions/quantity"}, "memory": {"$ref": "#/definitions/quantity"}}}, "resources": {"type": "object", "additionalProperties": false, "required": ["requests", "limits"], "properties": {"requests": {"$ref": "#/definitions/quantities"}, "limits": {"$ref": "#/definitions/quantities"}}}, "quota": {"type": "object", "additionalProperties": false, "required": ["enabled", "hard"], "properties": {"enabled": {"type": "boolean"}, "hard": {"type": "object", "additionalProperties": {"$ref": "#/definitions/quantity"}}}}
  }
}
